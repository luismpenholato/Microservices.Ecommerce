{
  "Jwt": {
    "Secret": "docker-demo-jwt-secret-key-min-32-chars!!",
    "Issuer": "Microservices.Ecommerce",
    "Audience": "Microservices.Ecommerce",
    "ExpirationMinutes": 120
  },
  "ConnectionStrings": {
    "CatalogDb": "Host=postgres;Port=5432;Database=catalog_db;Username=postgres;Password=postgres"
  },
  "OpenTelemetry": {
    "PrometheusEnabled": true
  },
  "Serilog": {
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "serverUrl": "http://seq:80" } }
    ]
  }
}
