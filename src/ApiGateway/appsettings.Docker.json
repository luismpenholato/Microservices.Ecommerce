{
  "Jwt": {
    "Secret": "docker-demo-jwt-secret-key-min-32-chars!!",
    "Issuer": "Microservices.Ecommerce",
    "Audience": "Microservices.Ecommerce",
    "ExpirationMinutes": 120
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/identity/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity": { "Address": "http://identity-api:8080/" }
        }
      }
    }
  }
}
